# Dockerfile for running integration tests in Azure Container Instances
# This container runs within the VNet subnet to access resources via private endpoints and VNet rules

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

# Copy everything
COPY . .

# Restore all projects
RUN dotnet restore SqlBuildManager.Console.ExternalTest/SqlBuildManager.Console.ExternalTest.csproj
RUN dotnet restore SqlBuildManager.Console.PostgreSQL.ExternalTest/SqlBuildManager.Console.PostgreSQL.ExternalTest.csproj

# Build the test projects (this also builds dependencies)
RUN dotnet build SqlBuildManager.Console.ExternalTest/SqlBuildManager.Console.ExternalTest.csproj --configuration Release --no-restore -o /tests
RUN dotnet build SqlBuildManager.Console.PostgreSQL.ExternalTest/SqlBuildManager.Console.PostgreSQL.ExternalTest.csproj --configuration Release --no-restore -o /tests

# Copy TestConfig files to test output directory
RUN cp -r TestConfig /tests/TestConfig

# Create the final test runner image (using SDK since we need dotnet test)
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS testrunner

# Pinned kubectl version and architecture-aware SHA-256 checksums (update both when bumping).
# Checksums sourced from https://dl.k8s.io/release/<version>/bin/linux/<arch>/kubectl.sha256
ARG KUBECTL_VERSION=v1.33.0
ARG KUBECTL_AMD64_SHA256=9efe8d3facb23e1618cba36fb1c4e15ac9dc3ed5a2c2e18109e4a66b2bac12dc
ARG KUBECTL_ARM64_SHA256=48541d119455ac5bcc5043275ccda792371e0b112483aa0b29378439cf6322b9

# Install Azure CLI from the signed Microsoft package repository and kubectl with SHA-256 verification.
# No remote shell scripts are executed (replaces the former curl | bash Azure CLI install).
RUN apt-get update && \
    apt-get install -y ca-certificates curl apt-transport-https lsb-release gnupg && \
    mkdir -p /etc/apt/keyrings && \
    curl -sLS https://packages.microsoft.com/keys/microsoft.asc | \
      gpg --dearmor -o /etc/apt/keyrings/microsoft.gpg && \
    chmod go+r /etc/apt/keyrings/microsoft.gpg && \
    AZ_DIST=$(lsb_release -cs) && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/azure-cli/ ${AZ_DIST} main" \
      > /etc/apt/sources.list.d/azure-cli.list && \
    apt-get update && \
    apt-get install -y azure-cli && \
    ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "amd64" ]; then EXPECTED_SHA256="${KUBECTL_AMD64_SHA256}"; \
    elif [ "$ARCH" = "arm64" ]; then EXPECTED_SHA256="${KUBECTL_ARM64_SHA256}"; \
    else echo "Unsupported architecture: $ARCH" >&2 && exit 1; fi && \
    curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${ARCH}/kubectl" -o /tmp/kubectl && \
    echo "${EXPECTED_SHA256}  /tmp/kubectl" | sha256sum -c - && \
    install -o root -g root -m 0755 /tmp/kubectl /usr/local/bin/kubectl && \
    rm /tmp/kubectl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /tests

# Copy built test assemblies and TestConfig
COPY --from=build /tests .

# Set environment variables for test execution
ENV DOTNET_ENVIRONMENT=Production
ENV AZURE_CLIENT_ID=""

# Default entry point runs all tests, but can be overridden with --filter
# Examples:
#   --filter "FullyQualifiedName~ContainerApp"
#   --filter "FullyQualifiedName~AciTests"
#   --filter "TestCategory=Integration"
ENTRYPOINT ["dotnet", "vstest", "SqlBuildManager.Console.ExternalTest.dll", "--logger:trx;LogFileName=TestResults.trx", "--logger:console;verbosity=detailed"]
