# syntax=docker/dockerfile:1
# Integration test runner for VNet-integrated Azure Container Instances.

FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:ed034a8bf0b24ded0cbbac07e17825d8e9ebfe21e308191d0f7421eaf5ad4664 AS restore
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props ./
COPY SqlBuildManager.Console.ExternalTest/SqlBuildManager.Console.ExternalTest.csproj SqlBuildManager.Console.ExternalTest/packages.lock.json SqlBuildManager.Console.ExternalTest/
COPY SqlBuildManager.Console.PostgreSQL.ExternalTest/SqlBuildManager.Console.PostgreSQL.ExternalTest.csproj SqlBuildManager.Console.PostgreSQL.ExternalTest/packages.lock.json SqlBuildManager.Console.PostgreSQL.ExternalTest/
COPY SqlBuildManager.Console.MySQL.ExternalTest/SqlBuildManager.Console.MySQL.ExternalTest.csproj SqlBuildManager.Console.MySQL.ExternalTest/packages.lock.json SqlBuildManager.Console.MySQL.ExternalTest/
COPY SqlBuildManager.Console/sbm.csproj SqlBuildManager.Console/packages.lock.json SqlBuildManager.Console/
COPY SqlBuildManager.Enterprise/SqlBuildManager.Enterprise.csproj SqlBuildManager.Enterprise/packages.lock.json SqlBuildManager.Enterprise/
COPY SqlBuildManager.Interfaces/SqlBuildManager.Interfaces.csproj SqlBuildManager.Interfaces/packages.lock.json SqlBuildManager.Interfaces/
COPY SqlBuildManager.Logging/SqlBuildManager.Logging.csproj SqlBuildManager.Logging/packages.lock.json SqlBuildManager.Logging/
COPY SqlBuildManager.ScriptHandling/SqlBuildManager.ScriptHandling.csproj SqlBuildManager.ScriptHandling/packages.lock.json SqlBuildManager.ScriptHandling/
COPY SqlSync.Connection/SqlSync.Connection.csproj SqlSync.Connection/packages.lock.json SqlSync.Connection/
COPY SqlSync.Constants/SqlSync.Constants.csproj SqlSync.Constants/packages.lock.json SqlSync.Constants/
COPY SqlSync.DbInformation/SqlSync.DbInformation.csproj SqlSync.DbInformation/packages.lock.json SqlSync.DbInformation/
COPY SqlSync.ObjectScript/SqlSync.ObjectScript.csproj SqlSync.ObjectScript/packages.lock.json SqlSync.ObjectScript/
COPY SqlSync.SqlBuild/SqlSync.SqlBuild.csproj SqlSync.SqlBuild/packages.lock.json SqlSync.SqlBuild/
RUN dotnet restore SqlBuildManager.Console.ExternalTest/SqlBuildManager.Console.ExternalTest.csproj --locked-mode && \
    dotnet restore SqlBuildManager.Console.PostgreSQL.ExternalTest/SqlBuildManager.Console.PostgreSQL.ExternalTest.csproj --locked-mode && \
    dotnet restore SqlBuildManager.Console.MySQL.ExternalTest/SqlBuildManager.Console.MySQL.ExternalTest.csproj --locked-mode

FROM restore AS build
COPY . .
RUN dotnet build SqlBuildManager.Console.ExternalTest/SqlBuildManager.Console.ExternalTest.csproj \
      --configuration Release --framework net10.0 --no-restore --output /tests && \
    dotnet build SqlBuildManager.Console.PostgreSQL.ExternalTest/SqlBuildManager.Console.PostgreSQL.ExternalTest.csproj \
      --configuration Release --framework net10.0 --no-restore --output /tests && \
    dotnet build SqlBuildManager.Console.MySQL.ExternalTest/SqlBuildManager.Console.MySQL.ExternalTest.csproj \
      --configuration Release --framework net10.0 --no-restore --output /tests && \
    cp -r TestConfig /tests/TestConfig

FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:ed034a8bf0b24ded0cbbac07e17825d8e9ebfe21e308191d0f7421eaf5ad4664 AS testrunner

# Pinned kubectl version and architecture-aware SHA-256 checksums (update both when bumping).
# Checksums sourced from https://dl.k8s.io/release/<version>/bin/linux/<arch>/kubectl.sha256
ARG KUBECTL_VERSION=v1.33.0
ARG KUBECTL_AMD64_SHA256=9efe8d3facb23e1618cba36fb1c4e15ac9dc3ed5a2c2e18109e4a66b2bac12dc
ARG KUBECTL_ARM64_SHA256=48541d119455ac5bcc5043275ccda792371e0b112483aa0b29378439cf6322b9

RUN sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl apt-transport-https gnupg && \
    mkdir -p /etc/apt/keyrings && \
    curl -sLS https://packages.microsoft.com/keys/microsoft.asc | \
      gpg --dearmor -o /etc/apt/keyrings/microsoft.gpg && \
    chmod go+r /etc/apt/keyrings/microsoft.gpg && \
    . /etc/os-release && AZ_DIST="${VERSION_CODENAME}" && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/azure-cli/ ${AZ_DIST} main" \
      > /etc/apt/sources.list.d/azure-cli.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends azure-cli && \
    ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "amd64" ]; then EXPECTED_SHA256="${KUBECTL_AMD64_SHA256}"; \
    elif [ "$ARCH" = "arm64" ]; then EXPECTED_SHA256="${KUBECTL_ARM64_SHA256}"; \
    else echo "Unsupported architecture: $ARCH" >&2 && exit 1; fi && \
    curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${ARCH}/kubectl" -o /tmp/kubectl && \
    echo "${EXPECTED_SHA256}  /tmp/kubectl" | sha256sum -c - && \
    install -o root -g root -m 0755 /tmp/kubectl /usr/local/bin/kubectl && \
    rm /tmp/kubectl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /tests
COPY --from=build /tests .
ENV DOTNET_ENVIRONMENT=Production
ENV AZURE_CLIENT_ID=""
ENTRYPOINT ["dotnet", "vstest", "SqlBuildManager.Console.ExternalTest.dll", "--logger:trx;LogFileName=TestResults.trx", "--logger:console;verbosity=detailed"]
